{
  "_format": {
    "note": "Card definitions. Each card has an id, name, cost (insight), school, rarity, effects[] (composed into a play resolution), flags, and prose. The effects array runs top-to-bottom. Card text is generated from effects[] by src/card.js cardDescriptor() but a prose.use/hit may override the log line.",
    "effects": "Effect types: fill (add pages to target file), compress (remove pages from target file), condition (apply N stacks), cleanse (remove conditions), draw (draw N), insight (gain N insight this turn), exhaust_from_hand (force exhaust), self_taint (add a taint card to draw pile), copy_to_hand (copy named card / last played / specific into hand), copy_to_draw (insert into draw pile), retain_hand (don't discard at end of turn), negate_intent (cancel opponent's queued intent), reroll_intent (force re-pick), substitute (consume a card from hand for fill), echo_next (next card you play this turn plays twice), summon_haunt (begin a multi-turn fill source), shell_turn (take no pages from opponent this turn), reset_intent_exhaust, take_pages (add pages to your file as a cost), apply_random_condition, transfer_conditions (move all conditions from self to enemy), kill_check (extra effect if this kills).",
    "rarity": "starter = in starting deck only, common/uncommon/rare = absorption + shop pool, synthesis = produced by compilation only.",
    "flags": "exhaust: removes the card from this battle after play. retain: not discarded at end of turn. unplayable: cannot be played; usually a taint."
  },
